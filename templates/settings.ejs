<%- include('header') %>

<div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <div class="mb-6">
        <h2 class="text-xl font-black text-gray-800 uppercase italic">Configuração Simplificada</h2>
        <p class="text-gray-500 text-xs font-bold uppercase">Configure o acesso à nuvem ConectaSF</p>
    </div>

    <form method="POST" action="/settings" class="space-y-6">

        <!-- URL ÚNICA -->
        <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">URL da Instância (Domínio Principal)</label>
            <input type="text" name="BASE_URL" value="<%= config.BASE_URL %>"
                   placeholder="Ex: https://seusite.com.br" required
                   class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-4 text-sm font-bold outline-none focus:border-primary transition-all">
            <p class="mt-2 text-[9px] text-gray-400 font-bold uppercase italic">O sistema configurará automaticamente os caminhos de API, Chat e Cardápio.</p>
        </div>

        <!-- TOKEN -->
        <div>
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Chave de Acesso (API Token)</label>
            <input type="text" name="API_TOKEN" value="<%= config.API_TOKEN %>"
                   placeholder="Insira seu token de segurança" required
                   class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-4 text-sm font-mono text-blue-600 outline-none focus:border-blue-500 transition-all">
        </div>

        <!-- MODO TESTE (Mantido) -->
        <div class="p-5 bg-amber-50 rounded-2xl border border-amber-100">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <span class="block font-black text-amber-800 text-xs uppercase">Modo de Teste</span>
                    <span class="text-[10px] text-amber-600 font-bold uppercase italic">Restringir o robô a números específicos</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="MODO_TESTE" class="sr-only peer" <%= config.MODO_TESTE ? 'checked' : '' %>>
                    <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:bg-amber-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
                </label>
            </div>
            <input type="text" name="NUMERO_TESTE" value="<%= config.NUMERO_TESTE %>"
                   placeholder="Ex: 5522999999999, 5521888888888"
                   class="w-full bg-white border border-amber-200 rounded-xl px-4 py-3 text-sm font-bold text-amber-900 outline-none focus:border-amber-500">
        </div>

        <div class="pt-2 flex gap-3">
            <button type="submit" class="flex-1 bg-gray-900 text-white py-4 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-black transition shadow-lg active:scale-95">
                Salvar Configurações
            </button>
            <a href="/" class="px-6 py-4 text-gray-400 font-bold text-xs uppercase flex items-center hover:text-gray-700 transition">
                Voltar
            </a>
        </div>
    </form>
</div>

<!-- PREVIEW (OPCIONAL - Apenas para debug visual do logista ver as URLs sendo montadas) -->
<% if (config.BASE_URL) { %>
<div class="mt-6 px-4 py-3 border-t border-gray-100">
    <details class="cursor-pointer">
        <summary class="text-[9px] font-black text-gray-300 uppercase tracking-widest">Ver detalhes técnicos da conexão</summary>
        <div class="mt-2 space-y-1">
            <p class="text-[9px] text-gray-400 font-mono">API: <%= config.DJANGO_HTTP_URL %></p>
            <p class="text-[9px] text-gray-400 font-mono">WSS: <%= config.DJANGO_WS_URL %></p>
            <p class="text-[9px] text-gray-400 font-mono">Loja: <%= config.CARDAPIO_URL %></p>
        </div>
    </details>
</div>
<% } %>

<%- include('footer') %>