<%- include('header') %>

<div class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="bg-white/90 backdrop-blur-md p-8 rounded-[2rem] shadow-2xl border border-white/50 w-full max-w-lg transition-all duration-500">

        <!-- TÍTULO -->
        <h2 class="text-xl font-black mb-8 flex items-center justify-center gap-2 text-gray-800">
            <i data-lucide="smartphone" class="w-6 h-6 text-blue-600"></i>
            <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent uppercase tracking-tight">Status do WhatsApp</span>
        </h2>

        <!-- CONTAINER PRINCIPAL DE ESTADOS -->
        <div id="ui-container" class="flex flex-col items-center justify-center min-h-[340px] w-full relative">

            <!-- ESTADO: CARREGANDO -->
            <div id="state-loading" class="flex flex-col items-center justify-center w-full animate-fadeIn">
                <div class="relative mb-6">
                    <i data-lucide="loader-2" class="w-16 h-16 text-blue-600 animate-spin"></i>
                </div>
                <h3 id="loading-title" class="text-xl font-black text-gray-800">Iniciando...</h3>
                <p id="loading-desc" class="text-gray-500 mt-2 text-sm font-bold text-center px-6 leading-relaxed">Conectando aos serviços locais.</p>
            </div>

            <!-- ESTADO: QR CODE (Otimizado para leitura) -->
            <div id="state-qr" class="hidden flex flex-col items-center justify-center w-full animate-fadeIn">
                <!-- Moldura Branca Pura (Essencial para leitura óptica) -->
                <div class="bg-white p-5 rounded-[1.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-gray-100 mb-6 flex items-center justify-center">
                    <img id="qrcode"
                         class="block transition-all duration-300"
                         width="240"
                         height="240"
                         style="image-rendering: pixelated;"
                         alt="WhatsApp QR Code">
                </div>

                <div class="text-center">
                    <h3 class="text-2xl font-black text-gray-800 leading-tight">Aguardando Leitura</h3>
                    <p class="text-gray-500 mt-2 text-sm font-bold px-8">
                        Abra o WhatsApp > Dispositivos Conectados > Conectar um dispositivo.
                    </p>
                </div>
            </div>

            <!-- ESTADO: TUDO CONECTADO -->
            <div id="state-connected" class="hidden flex flex-col items-center justify-center w-full animate-bounceIn">
                <div class="w-28 h-28 bg-gradient-to-br from-green-400 to-emerald-500 text-white rounded-full flex items-center justify-center mb-6 shadow-2xl shadow-green-200">
                    <i data-lucide="check" class="w-14 h-14 stroke-[4px]"></i>
                </div>
                <h3 class="text-2xl font-black text-gray-800 uppercase tracking-tighter">Sistema Online</h3>
                <p class="text-gray-500 mt-2 text-sm font-bold text-center px-10">WhatsApp conectado e pronto para enviar mensagens.</p>
            </div>
        </div>

        <!-- BARRA DE STATUS INFERIOR -->
        <div id="status-bar" class="mt-8 text-[11px] font-black uppercase tracking-widest py-4 px-6 rounded-2xl border transition-all duration-500 text-center bg-gray-50 border-gray-100 text-gray-400">
            Verificando status...
        </div>

        <!-- BOTÃO DE CONFIGURAÇÕES -->
        <div class="mt-8 pt-6 border-t border-gray-100">
            <a href="/settings" class="flex items-center justify-center gap-2 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] hover:text-blue-600 transition-all group">
                <i data-lucide="settings" class="w-4 h-4 group-hover:rotate-90 transition-transform duration-500"></i>
                Configurações do Robô
            </a>
        </div>
    </div>
</div>

<script>
    const socket = io({ reconnectionAttempts: 10, reconnectionDelay: 2000 });

    const stateLoading = document.getElementById('state-loading');
    const stateQr = document.getElementById('state-qr');
    const stateConnected = document.getElementById('state-connected');
    const statusBar = document.getElementById('status-bar');

    function showState(state) {
        stateLoading.classList.add('hidden');
        stateQr.classList.add('hidden');
        stateConnected.classList.add('hidden');

        if (state === 'loading') stateLoading.classList.remove('hidden');
        if (state === 'qr') {
            stateQr.classList.remove('hidden');
            stateQr.classList.add('flex'); // Garante que o flex seja aplicado
        }
        if (state === 'connected') {
            stateConnected.classList.remove('hidden');
            stateConnected.classList.add('flex');
        }
    }

    function setStatusBar(text, colorClass) {
        statusBar.innerText = text;
        statusBar.className = `mt-8 text-[11px] font-black uppercase tracking-widest py-4 px-6 rounded-2xl border transition-all duration-500 text-center ${colorClass}`;
    }

    socket.on("connect_error", () => {
        showState('loading');
        document.getElementById('loading-title').innerText = "Servidor Offline";
        document.getElementById('loading-desc').innerText = "Tentando conexão com o serviço local...";
        setStatusBar("Erro: Robô Desligado", "text-red-600 bg-red-50 border-red-100");
    });

    socket.on("status_update", (data) => {
        const { status, qr } = data;

        if (status === "starting") {
            showState('loading');
            document.getElementById('loading-title').innerText = "Ligando Motores...";
            setStatusBar("Iniciando Baileys", "text-blue-600 bg-blue-50 border-blue-100");
        }
        else if (status === "connecting") {
            showState('loading');
            document.getElementById('loading-title').innerText = "Sincronizando...";
            setStatusBar("Conectando WhatsApp", "text-amber-600 bg-amber-50 border-amber-100");
        }
        else if (status === "qr") {
            showState('qr');
            if(qr) document.getElementById('qrcode').src = qr;
            setStatusBar("Escaneie o QR Code", "text-blue-600 bg-blue-50 border-blue-100 shadow-sm");
        }
        else if (status === "connected") {
            showState('connected');
            setStatusBar("Sistema Operacional", "text-green-600 bg-green-50 border-green-100 shadow-sm shadow-green-100");
        }
        else if (status === "cloud_disconnected") {
            showState('loading');
            document.getElementById('loading-title').innerText = "Nuvem Desconectada";
            setStatusBar("Erro na Nuvem", "text-orange-600 bg-orange-50 border-orange-100");
        }
    });

    lucide.createIcons();
</script>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
        animation: fadeIn 0.4s ease-out forwards;
    }

    @keyframes bounceIn {
        0% { opacity: 0; transform: scale(0.3); }
        50% { opacity: 1; transform: scale(1.05); }
        70% { transform: scale(0.9); }
        100% { transform: scale(1); }
    }
    .animate-bounceIn {
        animation: bounceIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
</style>

<%- include('footer') %>